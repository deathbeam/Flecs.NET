<Project>
    <PropertyGroup>
        <FlecsStaticPath>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../static/$(RuntimeIdentifier)/native/'))</FlecsStaticPath>
        <FlecsStaticLibrary Condition="$(RuntimeIdentifier.StartsWith('win-'))">$(FlecsStaticPath)flecs_static.lib</FlecsStaticLibrary>
        <FlecsStaticLibrary Condition="!$(RuntimeIdentifier.StartsWith('win-'))">$(FlecsStaticPath)libflecs.a</FlecsStaticLibrary>
    </PropertyGroup>

    <ItemGroup Condition="'$(PublishAot)' == 'true' And Exists('$(FlecsStaticLibrary)')">
        <DirectPInvoke Include="flecs"/>
        <NativeLibrary Include="$(FlecsStaticLibrary)"/>
    </ItemGroup>

    <ItemGroup Condition="'$(PublishAot)' == 'true' And $(RuntimeIdentifier.StartsWith('win-')) And Exists('$(FlecsStaticLibrary)')">
        <NativeLibrary Include="dbghelp.lib"/>
    </ItemGroup>
</Project>
